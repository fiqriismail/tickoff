---
import { Icon } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AppScreenshot from '../components/AppScreenshot.astro';
import tasksLight from '../assets/screenshots/tasks-light.png';
import tasksDark from '../assets/screenshots/tasks-dark.png';
import goalsLight from '../assets/screenshots/daily-goals-light.png';
import goalsDark from '../assets/screenshots/daily-goals-dark.png';

const base = import.meta.env.BASE_URL;
const guide = `${base}guide/`;
const gettingStarted = `${guide}getting-started/`;
const download = 'https://github.com/fiqriismail/tickoff/releases/latest';
---

<StarlightPage
	frontmatter={{
		title: 'Tasks and daily goals for macOS',
		description: 'A native macOS task manager for tasks, projects and daily goals. Local storage, no account, and a familiar Mac experience.',
		template: 'splash',
		pagefind: false,
		hero: {
			title: 'Tasks and daily goals.<br><span class="hero-accent">Native to your Mac.</span>',
			tagline: 'A quieter place for everything you want to get done. Organise your projects, focus on your tasks, and make room for a daily rhythm.',
			actions: [
				{ text: 'Download for macOS', link: download, icon: 'download' },
				{ text: 'Read the guide', link: guide, variant: 'secondary', icon: 'right-arrow' },
			],
		},
	}}
>
	<div class="landing">
		<p class="requirements">macOS 14 Sonoma or later <span aria-hidden="true">&middot;</span> Apple Silicon &amp; Intel</p>

		<AppScreenshot light={tasksLight} dark={tasksDark}
			alt="Tickoff task list with projects, status filters, notes, priorities and due dates."
			caption="Your projects and tasks, together in one native Mac window." eager />

		<section class="features section" aria-labelledby="features-title">
			<div class="section-heading">
				<p class="eyebrow">Just enough structure</p>
				<h2 id="features-title">Less organising.<br>More getting things done.</h2>
				<p>A quick thought or a whole project. Keep the details you need, without getting lost in them.</p>
			</div>
			<div class="feature-grid">
				<article>
					<div class="feature-icon"><Icon name="list-format" size="1.5rem" /></div>
					<h3>A place for every project</h3>
					<p>Start in Inbox, group related tasks into projects, and see the bigger picture in All Projects.</p>
				</article>
				<article>
					<div class="feature-icon"><Icon name="magnifier" size="1.5rem" /></div>
					<h3>Find your next step</h3>
					<p>Search titles and notes, filter by status, and use priorities and due dates to decide what comes next.</p>
				</article>
				<article>
					<div class="feature-icon"><Icon name="sun" size="1.5rem" /></div>
					<h3>Make room for every day</h3>
					<p>Give recurring intentions their own Daily Goals project, with simple check-offs and counters.</p>
				</article>
			</div>
		</section>

		<section class="daily-goals section" aria-labelledby="goals-title">
			<div class="goals-copy">
				<p class="eyebrow">Daily Goals</p>
				<h2 id="goals-title">A fresh start.<br>Every single day.</h2>
				<p>Some things aren't a task to finish once. Check off your daily intentions or count your progress towards a target in a dedicated Today view.</p>
				<ul>
					<li><Icon name="approve-check" /> Check-offs for the things you do once a day.</li>
					<li><Icon name="approve-check" /> Whole-number counters for the things that add up.</li>
					<li><Icon name="approve-check" /> Fresh progress each local day, with past progress kept.</li>
				</ul>
				<a class="text-link" href={`${gettingStarted}#explore-projects-and-daily-goals`}>
					Get started with Daily Goals <Icon name="right-arrow" />
				</a>
			</div>
			<AppScreenshot light={goalsLight} dark={goalsDark}
				alt="Daily Wellbeing Today view with a completed reading check-off, water at 5 of 8, an incomplete walk and stretch breaks at 3 of 3."
				caption="Daily check-offs and counters, with a fresh start each day." />
		</section>

		<section class="local section" aria-labelledby="local-title">
			<div class="local-icon"><Icon name="laptop" size="2rem" /></div>
			<div>
				<p class="eyebrow">At home on your Mac</p>
				<h2 id="local-title">Your tasks. Your computer.</h2>
				<p>Written in Swift and SwiftUI, with familiar keyboard shortcuts and system light and dark appearance. Your data stays in a local SQLite database. No account. No network access from the app.</p>
			</div>
		</section>

		<section class="get-started section" aria-labelledby="download-title">
			<p class="eyebrow">Ready when you are</p>
			<h2 id="download-title">Make space for what matters.</h2>
			<p>Download Tickoff, move it to Applications, and add your first task.</p>
			<a class="primary-button" href={download}><Icon name="download" /> Download for macOS</a>
			<p class="compatibility">macOS 14+ <span aria-hidden="true">&middot;</span> One download for Apple Silicon and Intel</p>
			<p class="signing-note">Tickoff is ad-hoc signed, not Developer ID signed or notarised.<br>
				macOS may require approval on first launch. <a href={`${base}help/troubleshooting/#macos-blocks-the-first-launch`}>See installation help</a>.
			</p>
		</section>
	</div>
</StarlightPage>

<style>
	:global(:root) {
		--sl-content-width: 74rem;
	}

	:global(main) {
		padding-top: 1rem;
	}

	:global(.hero) {
		grid-template-columns: 1fr;
		padding-block: clamp(2.5rem, 7vw, 6rem) 1.5rem;
	}

	:global(.hero .stack),
	:global(.hero .copy) {
		align-items: center;
		text-align: center;
	}

	:global(.hero h1) {
		font-size: clamp(2.4rem, 5.2vw, 4.75rem);
		font-weight: 650;
		letter-spacing: -0.045em;
		line-height: 1.12;
	}

	:global(.hero-accent) {
		color: var(--sl-color-accent-high);
	}

	:global(:root[data-theme="light"] .hero-accent) {
		color: var(--sl-color-accent);
	}

	:global(.hero .tagline) {
		max-width: 38rem;
		font-size: 1.125rem;
		line-height: 1.7;
	}

	:global(.hero .actions) {
		justify-content: center;
		gap: 0.75rem;
	}

	:global(.hero .sl-link-button) {
		border-radius: 0.75rem;
	}

	:global(.sl-markdown-content .landing :is(h2, h3, p, ul, li)) {
		margin-top: 0;
	}

	.landing {
		color: var(--sl-color-gray-2);
		line-height: 1.7;
	}

	.landing h2,
	.landing h3 {
		color: var(--sl-color-white);
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.landing h2 {
		font-size: clamp(1.875rem, 3.5vw, 2.75rem);
		font-weight: 600;
	}

	.landing h3 {
		font-size: 1.25rem;
		font-weight: 600;
	}

	.landing p {
		margin-bottom: 0;
	}

	.requirements {
		text-align: center;
		font-size: 0.875rem;
	}

	.requirements span,
	.compatibility span {
		margin-inline: 0.375rem;
	}

	.section {
		padding-block: clamp(3rem, 7vw, 6rem);
	}

	.section-heading {
		max-width: 38rem;
		margin-inline: auto;
		text-align: center;
	}

	.landing .eyebrow {
		margin-bottom: 1rem;
		color: var(--sl-color-accent-high);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	:global([data-theme="light"]) .eyebrow {
		color: var(--sl-color-accent);
	}

	.section-heading > p:last-child,
	.goals-copy > p:not(.eyebrow),
	.local h2 + p,
	.get-started h2 + p {
		padding-top: 1.25rem;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		padding-top: 3rem;
	}

	.feature-grid article {
		padding: 1.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1.25rem;
	}

	.feature-icon,
	.local-icon {
		display: inline-flex;
		padding: 0.75rem;
		border-radius: 0.875rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}

	.feature-grid h3 {
		padding-block: 1.5rem 0.75rem;
	}

	.feature-grid p {
		font-size: 0.9375rem;
	}

	.daily-goals {
		border-top: 1px solid var(--sl-color-hairline);
	}

	.goals-copy {
		max-width: 44rem;
	}

	.goals-copy ul {
		display: grid;
		gap: 0.75rem;
		padding: 1.5rem 0;
		list-style: none;
	}

	.goals-copy li {
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		font-size: 0.9375rem;
	}

	.goals-copy li :global(svg) {
		flex-shrink: 0;
		color: var(--sl-color-accent-high);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 500;
		text-underline-offset: 0.25em;
	}

	.local {
		display: flex;
		gap: 2rem;
		align-items: start;
		max-width: 52rem;
		margin-inline: auto;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.local-icon {
		flex-shrink: 0;
	}

	.get-started {
		padding-inline: 1.5rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1.5rem;
		background: var(--sl-color-gray-6);
		text-align: center;
	}

	.primary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		margin-block: 1.75rem 1rem;
		padding: 0.875rem 1.375rem;
		border-radius: 0.75rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-text-invert);
		font-weight: 500;
		text-decoration: none;
	}

	.primary-button:hover {
		filter: brightness(1.1);
	}

	.compatibility,
	.signing-note {
		font-size: 0.875rem;
	}

	.landing .signing-note {
		padding-top: 1.5rem;
	}

	@media (max-width: 54rem) {
		.feature-grid {
			gap: 1rem;
		}

		.feature-grid article {
			padding: 1.25rem;
		}

	}

	@media (max-width: 38rem) {
		:global(:root) {
			--sl-nav-height: 7rem;
		}

		.feature-grid {
			grid-template-columns: 1fr;
		}

		.local {
			flex-direction: column;
			gap: 1.5rem;
		}

		:global(.hero h1) {
			font-size: clamp(2rem, 7.8vw, 3rem);
		}

		:global(.hero .actions) {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
