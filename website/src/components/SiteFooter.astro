---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';

const isHome = Astro.locals.starlightRoute.id === '';
const base = import.meta.env.BASE_URL;
---

{
	isHome ? (
		<footer class="landing-footer">
			<p>Tickoff <span>A little more focus. A little less fuss.</span></p>
			<nav aria-label="Footer">
				<a href={`${base}guide/`}>User Guide</a>
				<a href="https://github.com/fiqriismail/tickoff/releases">Releases</a>
				<a href="https://github.com/fiqriismail/tickoff/issues/new">Report an issue</a>
				<a href="https://github.com/fiqriismail/tickoff/blob/main/LICENSE">MIT licence</a>
				<a href="https://github.com/fiqriismail/tickoff"><Icon name="github" /> GitHub</a>
			</nav>
		</footer>
	) : <DefaultFooter />
}

<style>
	.landing-footer {
		display: flex;
		justify-content: space-between;
		align-items: start;
		flex-wrap: wrap;
		gap: 2rem;
		margin-top: 5rem;
		padding-block: 2rem 1rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: 0.875rem;
	}

	p {
		margin: 0;
		font-weight: 600;
	}

	p span {
		display: block;
		margin-top: 0.5rem;
		color: var(--sl-color-gray-2);
		font-weight: 400;
	}

	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
</style>
