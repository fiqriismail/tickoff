---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	light: ImageMetadata;
	dark: ImageMetadata;
	alt: string;
	caption: string;
	eager?: boolean;
}

const { light, dark, alt, caption, eager = false } = Astro.props;
---

<figure>
	<a href={light.src} class="light" aria-label={`${alt} Open full-size light image.`}>
		<Image src={light} alt={`${alt} Light appearance.`}
			widths={[640, 1024, 1440, 1920]} sizes="(min-width: 1200px) 1184px, calc(100vw - 32px)"
			format="webp" quality={90} loading={eager ? 'eager' : 'lazy'} />
	</a>
	<a href={dark.src} class="dark" aria-label={`${alt} Open full-size dark image.`}>
		<Image src={dark} alt={`${alt} Dark appearance.`}
			widths={[640, 1024, 1440, 1920]} sizes="(min-width: 1200px) 1184px, calc(100vw - 32px)"
			format="webp" quality={90} loading={eager ? 'eager' : 'lazy'} />
	</a>
	<figcaption>{caption} Select the image to view it full size.</figcaption>
</figure>

<style>
	figure {
		margin: 2rem 0;
	}

	a {
		display: block;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.875rem;
		overflow: hidden;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}

	.dark,
	:global([data-theme="dark"]) .light {
		display: none;
	}

	:global([data-theme="dark"]) .dark {
		display: block;
	}

	figcaption {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-2);
		font-size: 0.8125rem;
		text-align: center;
	}
</style>
